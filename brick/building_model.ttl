# =============================================================================
# SECTION 9: OUTDOOR WEATHER STATION — WS-ROOF (MQTT)
# =============================================================================

bldg:weather_station a brick:Weather_Station ;
    rdfs:label "Outdoor Weather Station (Rooftop)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ws_drybulb_temp ,
        bldg:ws_humidity ,
        bldg:ws_wetbulb_temp .

bldg:ws_drybulb_temp  a brick:Outside_Air_Temperature_Sensor ; rdfs:label "Weather Station Dry-Bulb Temp (°C)" ; brick:isPointOf bldg:weather_station .
bldg:ws_humidity      a brick:Outside_Air_Humidity_Sensor    ; rdfs:label "Weather Station Humidity (%RH)"     ; brick:isPointOf bldg:weather_station .
bldg:ws_wetbulb_temp  a brick:Wet_Bulb_Temperature_Sensor    ; rdfs:label "Weather Station Wet-Bulb Temp (°C)" ; brick:isPointOf bldg:weather_station .

# =============================================================================
# SECTION 10: ELECTRICAL METERING — 21 meters total (Modbus TCP)
# 5 data points each: voltage_LL_average, current, power, energy, power_factor
# =============================================================================

# --- Main Building Meter ---
bldg:pm_main a brick:Building_Electrical_Meter ;
    rdfs:label "Main Building Power Meter (PM-MAIN)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:pm_main_voltage , bldg:pm_main_current ,
        bldg:pm_main_power , bldg:pm_main_energy , bldg:pm_main_pf .

bldg:pm_main_voltage a brick:Voltage_Sensor      ; rdfs:label "PM-MAIN Voltage LL Avg (V)"    ; brick:isPointOf bldg:pm_main .
bldg:pm_main_current a brick:Current_Sensor      ; rdfs:label "PM-MAIN Total Current (A)"      ; brick:isPointOf bldg:pm_main .
bldg:pm_main_power   a brick:Electric_Power_Sensor ; rdfs:label "PM-MAIN Active Power (kW)"   ; brick:isPointOf bldg:pm_main .
bldg:pm_main_energy  a brick:Electric_Energy_Sensor; rdfs:label "PM-MAIN Energy (kWh)"         ; brick:isPointOf bldg:pm_main .
bldg:pm_main_pf      a brick:Power_Factor_Sensor  ; rdfs:label "PM-MAIN Power Factor"          ; brick:isPointOf bldg:pm_main .

