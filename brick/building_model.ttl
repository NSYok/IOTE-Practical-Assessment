# =============================================================================
# SECTION 11: SYSTEM FEED CHAINS (Refrigeration/Hydraulic Circuit)
# Chillers → CHWPs → AHUs → VAVs → Zones
# Cooling Towers → CDWPs → Chillers (condenser side)
# =============================================================================

# Chiller → Chilled Water Pump (supply side)
bldg:chiller_1 brick:feeds bldg:chp_1 .
bldg:chiller_2 brick:feeds bldg:chp_2 .
bldg:chiller_3 brick:feeds bldg:chp_3 .

# Chilled Water Pump → AHUs (distributed across floors)
bldg:chp_1 brick:feeds bldg:ahu_f1 .
bldg:chp_2 brick:feeds bldg:ahu_f2 .
bldg:chp_3 brick:feeds bldg:ahu_f3 , bldg:ahu_f4 .

# Cooling Tower → Condenser Water Pump (return side)
bldg:cooling_tower_1 brick:feeds bldg:cdp_1 .
bldg:cooling_tower_2 brick:feeds bldg:cdp_2 .
bldg:cooling_tower_3 brick:feeds bldg:cdp_3 .

# Condenser Water Pump → Chiller (condenser inlet)
bldg:cdp_1 brick:feeds bldg:chiller_1 .
bldg:cdp_2 brick:feeds bldg:chiller_2 .
bldg:cdp_3 brick:feeds bldg:chiller_3 .

# =============================================================================
# END OF MODEL
# Total entities: 1 Building, 4 Floors, 16 HVAC Zones,
#   3 Chillers, 3 CHP, 3 CDP, 3 CT,
#   4 AHUs, 16 VAVs,
#   8 IAQ Sensors, 1 Weather Station,
#   21 Power Meters
# =============================================================================
