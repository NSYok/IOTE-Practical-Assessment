# =============================================================================
# Brick Schema Model — 4-Floor Commercial Office Building
# Assessment: IoT Engineer Practical Assessment
#
# Equipment summary:
#   Chiller Plant : 3 Chillers + 3 CHWP + 3 CDWP + 3 Cooling Towers
#   Air Dist.     : 4 AHUs (1/floor) + 16 VAVs (4/floor)
#   Environmental : 8 IAQ Sensors (2/floor) + 1 Outdoor Weather Station
#   Electrical    : 21 Power Meters (1 main + 4 floor + 16 equipment sub-meters)
#
# Brick Schema reference: https://brickschema.org/schema/Brick
# =============================================================================

@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bldg:  <urn:bldg/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# ONTOLOGY HEADER
# =============================================================================

<urn:bldg/> a owl:Ontology ;
    rdfs:label "4-Floor Commercial Office Building — Brick Model" ;
    rdfs:comment "Complete Brick Schema model for IoT Engineer Assessment. Covers HVAC, IAQ, and electrical metering infrastructure." .

# =============================================================================
# SECTION 1: SPATIAL HIERARCHY
# Building → Floors → HVAC Zones
# =============================================================================

bldg:building a brick:Building ;
    rdfs:label "4-Floor Commercial Office Building" .

# --- Floors ---
bldg:floor_1 a brick:Floor ;
    rdfs:label "Floor 1" ;
    brick:isPartOf bldg:building .

bldg:floor_2 a brick:Floor ;
    rdfs:label "Floor 2" ;
    brick:isPartOf bldg:building .

bldg:floor_3 a brick:Floor ;
    rdfs:label "Floor 3" ;
    brick:isPartOf bldg:building .

bldg:floor_4 a brick:Floor ;
    rdfs:label "Floor 4" ;
    brick:isPartOf bldg:building .

# --- HVAC Zones: 4 per floor (A–D), 16 total ---
bldg:zone_1A a brick:HVAC_Zone ; rdfs:label "Zone 1A" ; brick:isPartOf bldg:floor_1 .
bldg:zone_1B a brick:HVAC_Zone ; rdfs:label "Zone 1B" ; brick:isPartOf bldg:floor_1 .
bldg:zone_1C a brick:HVAC_Zone ; rdfs:label "Zone 1C" ; brick:isPartOf bldg:floor_1 .
bldg:zone_1D a brick:HVAC_Zone ; rdfs:label "Zone 1D" ; brick:isPartOf bldg:floor_1 .

bldg:zone_2A a brick:HVAC_Zone ; rdfs:label "Zone 2A" ; brick:isPartOf bldg:floor_2 .
bldg:zone_2B a brick:HVAC_Zone ; rdfs:label "Zone 2B" ; brick:isPartOf bldg:floor_2 .
bldg:zone_2C a brick:HVAC_Zone ; rdfs:label "Zone 2C" ; brick:isPartOf bldg:floor_2 .
bldg:zone_2D a brick:HVAC_Zone ; rdfs:label "Zone 2D" ; brick:isPartOf bldg:floor_2 .

bldg:zone_3A a brick:HVAC_Zone ; rdfs:label "Zone 3A" ; brick:isPartOf bldg:floor_3 .
bldg:zone_3B a brick:HVAC_Zone ; rdfs:label "Zone 3B" ; brick:isPartOf bldg:floor_3 .
bldg:zone_3C a brick:HVAC_Zone ; rdfs:label "Zone 3C" ; brick:isPartOf bldg:floor_3 .
bldg:zone_3D a brick:HVAC_Zone ; rdfs:label "Zone 3D" ; brick:isPartOf bldg:floor_3 .

bldg:zone_4A a brick:HVAC_Zone ; rdfs:label "Zone 4A" ; brick:isPartOf bldg:floor_4 .
bldg:zone_4B a brick:HVAC_Zone ; rdfs:label "Zone 4B" ; brick:isPartOf bldg:floor_4 .
bldg:zone_4C a brick:HVAC_Zone ; rdfs:label "Zone 4C" ; brick:isPartOf bldg:floor_4 .
bldg:zone_4D a brick:HVAC_Zone ; rdfs:label "Zone 4D" ; brick:isPartOf bldg:floor_4 .

# =============================================================================
# SECTION 2: CHILLER PLANT
# 3 × 500 RT Chillers (BACnet/IP)
# =============================================================================

# --- Chiller CH-1 ---
bldg:chiller_1 a brick:Chiller ;
    rdfs:label "Chiller CH-1 (500 RT)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ch1_chw_supply_temp ,
        bldg:ch1_chw_return_temp ,
        bldg:ch1_chw_flow ,
        bldg:ch1_refrig_temp ,
        bldg:ch1_delta_temp ,
        bldg:ch1_approach_temp ,
        bldg:ch1_status_read ,
        bldg:ch1_status_write ,
        bldg:ch1_power ,
        bldg:ch1_alarm ,
        bldg:ch1_pct_rla ,
        bldg:ch1_efficiency ,
        bldg:ch1_cooling_rate .

bldg:ch1_chw_supply_temp   a brick:Chilled_Water_Supply_Temperature_Sensor ; rdfs:label "CH-1 Evap Leaving Water Temp"     ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_chw_return_temp   a brick:Chilled_Water_Return_Temperature_Sensor ; rdfs:label "CH-1 Evap Entering Water Temp"    ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_chw_flow          a brick:Chilled_Water_Flow_Sensor               ; rdfs:label "CH-1 Evap Water Flow Rate (GPM)"  ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_refrig_temp       a brick:Refrigerant_Temperature_Sensor          ; rdfs:label "CH-1 Evap Sat Refrigerant Temp"   ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_delta_temp        a brick:Differential_Temperature_Sensor         ; rdfs:label "CH-1 Evap Water Delta Temp"        ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_approach_temp     a brick:Temperature_Sensor                      ; rdfs:label "CH-1 Evap Approach Temp"           ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_status_read       a brick:On_Off_Status                           ; rdfs:label "CH-1 Running Status"               ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_status_write      a brick:On_Off_Command                          ; rdfs:label "CH-1 Start/Stop Command"           ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_power             a brick:Electric_Power_Sensor                   ; rdfs:label "CH-1 Power (kW)"                   ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_alarm             a brick:Alarm                                   ; rdfs:label "CH-1 Alarm Status"                 ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_pct_rla           a brick:Current_Sensor                          ; rdfs:label "CH-1 Percentage RLA (%)"           ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_efficiency        a brick:Efficiency_Sensor                       ; rdfs:label "CH-1 Efficiency (kW/RT)"           ; brick:isPointOf bldg:chiller_1 .
bldg:ch1_cooling_rate      a brick:Cooling_Capacity_Sensor                 ; rdfs:label "CH-1 Cooling Rate (RT)"            ; brick:isPointOf bldg:chiller_1 .

# --- Chiller CH-2 ---
bldg:chiller_2 a brick:Chiller ;
    rdfs:label "Chiller CH-2 (500 RT)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ch2_chw_supply_temp ,
        bldg:ch2_chw_return_temp ,
        bldg:ch2_chw_flow ,
        bldg:ch2_refrig_temp ,
        bldg:ch2_delta_temp ,
        bldg:ch2_approach_temp ,
        bldg:ch2_status_read ,
        bldg:ch2_status_write ,
        bldg:ch2_power ,
        bldg:ch2_alarm ,
        bldg:ch2_pct_rla ,
        bldg:ch2_efficiency ,
        bldg:ch2_cooling_rate .

bldg:ch2_chw_supply_temp   a brick:Chilled_Water_Supply_Temperature_Sensor ; rdfs:label "CH-2 Evap Leaving Water Temp"     ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_chw_return_temp   a brick:Chilled_Water_Return_Temperature_Sensor ; rdfs:label "CH-2 Evap Entering Water Temp"    ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_chw_flow          a brick:Chilled_Water_Flow_Sensor               ; rdfs:label "CH-2 Evap Water Flow Rate (GPM)"  ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_refrig_temp       a brick:Refrigerant_Temperature_Sensor          ; rdfs:label "CH-2 Evap Sat Refrigerant Temp"   ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_delta_temp        a brick:Differential_Temperature_Sensor         ; rdfs:label "CH-2 Evap Water Delta Temp"        ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_approach_temp     a brick:Temperature_Sensor                      ; rdfs:label "CH-2 Evap Approach Temp"           ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_status_read       a brick:On_Off_Status                           ; rdfs:label "CH-2 Running Status"               ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_status_write      a brick:On_Off_Command                          ; rdfs:label "CH-2 Start/Stop Command"           ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_power             a brick:Electric_Power_Sensor                   ; rdfs:label "CH-2 Power (kW)"                   ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_alarm             a brick:Alarm                                   ; rdfs:label "CH-2 Alarm Status"                 ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_pct_rla           a brick:Current_Sensor                          ; rdfs:label "CH-2 Percentage RLA (%)"           ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_efficiency        a brick:Efficiency_Sensor                       ; rdfs:label "CH-2 Efficiency (kW/RT)"           ; brick:isPointOf bldg:chiller_2 .
bldg:ch2_cooling_rate      a brick:Cooling_Capacity_Sensor                 ; rdfs:label "CH-2 Cooling Rate (RT)"            ; brick:isPointOf bldg:chiller_2 .

# --- Chiller CH-3 ---
bldg:chiller_3 a brick:Chiller ;
    rdfs:label "Chiller CH-3 (500 RT)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ch3_chw_supply_temp ,
        bldg:ch3_chw_return_temp ,
        bldg:ch3_chw_flow ,
        bldg:ch3_refrig_temp ,
        bldg:ch3_delta_temp ,
        bldg:ch3_approach_temp ,
        bldg:ch3_status_read ,
        bldg:ch3_status_write ,
        bldg:ch3_power ,
        bldg:ch3_alarm ,
        bldg:ch3_pct_rla ,
        bldg:ch3_efficiency ,
        bldg:ch3_cooling_rate .

bldg:ch3_chw_supply_temp   a brick:Chilled_Water_Supply_Temperature_Sensor ; rdfs:label "CH-3 Evap Leaving Water Temp"     ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_chw_return_temp   a brick:Chilled_Water_Return_Temperature_Sensor ; rdfs:label "CH-3 Evap Entering Water Temp"    ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_chw_flow          a brick:Chilled_Water_Flow_Sensor               ; rdfs:label "CH-3 Evap Water Flow Rate (GPM)"  ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_refrig_temp       a brick:Refrigerant_Temperature_Sensor          ; rdfs:label "CH-3 Evap Sat Refrigerant Temp"   ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_delta_temp        a brick:Differential_Temperature_Sensor         ; rdfs:label "CH-3 Evap Water Delta Temp"        ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_approach_temp     a brick:Temperature_Sensor                      ; rdfs:label "CH-3 Evap Approach Temp"           ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_status_read       a brick:On_Off_Status                           ; rdfs:label "CH-3 Running Status"               ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_status_write      a brick:On_Off_Command                          ; rdfs:label "CH-3 Start/Stop Command"           ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_power             a brick:Electric_Power_Sensor                   ; rdfs:label "CH-3 Power (kW)"                   ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_alarm             a brick:Alarm                                   ; rdfs:label "CH-3 Alarm Status"                 ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_pct_rla           a brick:Current_Sensor                          ; rdfs:label "CH-3 Percentage RLA (%)"           ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_efficiency        a brick:Efficiency_Sensor                       ; rdfs:label "CH-3 Efficiency (kW/RT)"           ; brick:isPointOf bldg:chiller_3 .
bldg:ch3_cooling_rate      a brick:Cooling_Capacity_Sensor                 ; rdfs:label "CH-3 Cooling Rate (RT)"            ; brick:isPointOf bldg:chiller_3 .

# =============================================================================
# SECTION 3: CHILLED WATER PUMPS — CHP-1, CHP-2, CHP-3 (Modbus TCP, VSD)
# =============================================================================

bldg:chp_1 a brick:Chilled_Water_Pump ;
    rdfs:label "Chilled Water Pump CHP-1" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:chp1_status_read , bldg:chp1_status_write , bldg:chp1_alarm ,
        bldg:chp1_freq_read , bldg:chp1_freq_write , bldg:chp1_power .

bldg:chp1_status_read  a brick:On_Off_Status    ; rdfs:label "CHP-1 Running Status"         ; brick:isPointOf bldg:chp_1 .
bldg:chp1_status_write a brick:On_Off_Command   ; rdfs:label "CHP-1 Start/Stop Command"     ; brick:isPointOf bldg:chp_1 .
bldg:chp1_alarm        a brick:Alarm            ; rdfs:label "CHP-1 Alarm Status"           ; brick:isPointOf bldg:chp_1 .
bldg:chp1_freq_read    a brick:Frequency_Sensor ; rdfs:label "CHP-1 VSD Frequency (Hz)"     ; brick:isPointOf bldg:chp_1 .
bldg:chp1_freq_write   a brick:Frequency_Command; rdfs:label "CHP-1 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:chp_1 .
bldg:chp1_power        a brick:Electric_Power_Sensor ; rdfs:label "CHP-1 Power (kW)"        ; brick:isPointOf bldg:chp_1 .

bldg:chp_2 a brick:Chilled_Water_Pump ;
    rdfs:label "Chilled Water Pump CHP-2" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:chp2_status_read , bldg:chp2_status_write , bldg:chp2_alarm ,
        bldg:chp2_freq_read , bldg:chp2_freq_write , bldg:chp2_power .

bldg:chp2_status_read  a brick:On_Off_Status    ; rdfs:label "CHP-2 Running Status"         ; brick:isPointOf bldg:chp_2 .
bldg:chp2_status_write a brick:On_Off_Command   ; rdfs:label "CHP-2 Start/Stop Command"     ; brick:isPointOf bldg:chp_2 .
bldg:chp2_alarm        a brick:Alarm            ; rdfs:label "CHP-2 Alarm Status"           ; brick:isPointOf bldg:chp_2 .
bldg:chp2_freq_read    a brick:Frequency_Sensor ; rdfs:label "CHP-2 VSD Frequency (Hz)"     ; brick:isPointOf bldg:chp_2 .
bldg:chp2_freq_write   a brick:Frequency_Command; rdfs:label "CHP-2 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:chp_2 .
bldg:chp2_power        a brick:Electric_Power_Sensor ; rdfs:label "CHP-2 Power (kW)"        ; brick:isPointOf bldg:chp_2 .

bldg:chp_3 a brick:Chilled_Water_Pump ;
    rdfs:label "Chilled Water Pump CHP-3" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:chp3_status_read , bldg:chp3_status_write , bldg:chp3_alarm ,
        bldg:chp3_freq_read , bldg:chp3_freq_write , bldg:chp3_power .

bldg:chp3_status_read  a brick:On_Off_Status    ; rdfs:label "CHP-3 Running Status"         ; brick:isPointOf bldg:chp_3 .
bldg:chp3_status_write a brick:On_Off_Command   ; rdfs:label "CHP-3 Start/Stop Command"     ; brick:isPointOf bldg:chp_3 .
bldg:chp3_alarm        a brick:Alarm            ; rdfs:label "CHP-3 Alarm Status"           ; brick:isPointOf bldg:chp_3 .
bldg:chp3_freq_read    a brick:Frequency_Sensor ; rdfs:label "CHP-3 VSD Frequency (Hz)"     ; brick:isPointOf bldg:chp_3 .
bldg:chp3_freq_write   a brick:Frequency_Command; rdfs:label "CHP-3 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:chp_3 .
bldg:chp3_power        a brick:Electric_Power_Sensor ; rdfs:label "CHP-3 Power (kW)"        ; brick:isPointOf bldg:chp_3 .

# =============================================================================
# SECTION 4: CONDENSER WATER PUMPS — CDP-1, CDP-2, CDP-3 (Modbus TCP, VSD)
# =============================================================================

bldg:cdp_1 a brick:Condenser_Water_Pump ;
    rdfs:label "Condenser Water Pump CDP-1" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:cdp1_status_read , bldg:cdp1_status_write , bldg:cdp1_alarm ,
        bldg:cdp1_freq_read , bldg:cdp1_freq_write , bldg:cdp1_power .

bldg:cdp1_status_read  a brick:On_Off_Status    ; rdfs:label "CDP-1 Running Status"         ; brick:isPointOf bldg:cdp_1 .
bldg:cdp1_status_write a brick:On_Off_Command   ; rdfs:label "CDP-1 Start/Stop Command"     ; brick:isPointOf bldg:cdp_1 .
bldg:cdp1_alarm        a brick:Alarm            ; rdfs:label "CDP-1 Alarm Status"           ; brick:isPointOf bldg:cdp_1 .
bldg:cdp1_freq_read    a brick:Frequency_Sensor ; rdfs:label "CDP-1 VSD Frequency (Hz)"     ; brick:isPointOf bldg:cdp_1 .
bldg:cdp1_freq_write   a brick:Frequency_Command; rdfs:label "CDP-1 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:cdp_1 .
bldg:cdp1_power        a brick:Electric_Power_Sensor ; rdfs:label "CDP-1 Power (kW)"        ; brick:isPointOf bldg:cdp_1 .

bldg:cdp_2 a brick:Condenser_Water_Pump ;
    rdfs:label "Condenser Water Pump CDP-2" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:cdp2_status_read , bldg:cdp2_status_write , bldg:cdp2_alarm ,
        bldg:cdp2_freq_read , bldg:cdp2_freq_write , bldg:cdp2_power .

bldg:cdp2_status_read  a brick:On_Off_Status    ; rdfs:label "CDP-2 Running Status"         ; brick:isPointOf bldg:cdp_2 .
bldg:cdp2_status_write a brick:On_Off_Command   ; rdfs:label "CDP-2 Start/Stop Command"     ; brick:isPointOf bldg:cdp_2 .
bldg:cdp2_alarm        a brick:Alarm            ; rdfs:label "CDP-2 Alarm Status"           ; brick:isPointOf bldg:cdp_2 .
bldg:cdp2_freq_read    a brick:Frequency_Sensor ; rdfs:label "CDP-2 VSD Frequency (Hz)"     ; brick:isPointOf bldg:cdp_2 .
bldg:cdp2_freq_write   a brick:Frequency_Command; rdfs:label "CDP-2 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:cdp_2 .
bldg:cdp2_power        a brick:Electric_Power_Sensor ; rdfs:label "CDP-2 Power (kW)"        ; brick:isPointOf bldg:cdp_2 .

bldg:cdp_3 a brick:Condenser_Water_Pump ;
    rdfs:label "Condenser Water Pump CDP-3" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:cdp3_status_read , bldg:cdp3_status_write , bldg:cdp3_alarm ,
        bldg:cdp3_freq_read , bldg:cdp3_freq_write , bldg:cdp3_power .

bldg:cdp3_status_read  a brick:On_Off_Status    ; rdfs:label "CDP-3 Running Status"         ; brick:isPointOf bldg:cdp_3 .
bldg:cdp3_status_write a brick:On_Off_Command   ; rdfs:label "CDP-3 Start/Stop Command"     ; brick:isPointOf bldg:cdp_3 .
bldg:cdp3_alarm        a brick:Alarm            ; rdfs:label "CDP-3 Alarm Status"           ; brick:isPointOf bldg:cdp_3 .
bldg:cdp3_freq_read    a brick:Frequency_Sensor ; rdfs:label "CDP-3 VSD Frequency (Hz)"     ; brick:isPointOf bldg:cdp_3 .
bldg:cdp3_freq_write   a brick:Frequency_Command; rdfs:label "CDP-3 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:cdp_3 .
bldg:cdp3_power        a brick:Electric_Power_Sensor ; rdfs:label "CDP-3 Power (kW)"        ; brick:isPointOf bldg:cdp_3 .

# =============================================================================
# SECTION 5: COOLING TOWERS — CT-1, CT-2, CT-3 (Modbus TCP, VSD, 2 cells each)
# =============================================================================

bldg:cooling_tower_1 a brick:Cooling_Tower ;
    rdfs:label "Cooling Tower CT-1 (2 cells)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ct1_status_read , bldg:ct1_status_write , bldg:ct1_alarm ,
        bldg:ct1_freq_read , bldg:ct1_freq_write , bldg:ct1_power .

bldg:ct1_status_read  a brick:On_Off_Status    ; rdfs:label "CT-1 Running Status"         ; brick:isPointOf bldg:cooling_tower_1 .
bldg:ct1_status_write a brick:On_Off_Command   ; rdfs:label "CT-1 Start/Stop Command"     ; brick:isPointOf bldg:cooling_tower_1 .
bldg:ct1_alarm        a brick:Alarm            ; rdfs:label "CT-1 Alarm Status"           ; brick:isPointOf bldg:cooling_tower_1 .
bldg:ct1_freq_read    a brick:Frequency_Sensor ; rdfs:label "CT-1 VSD Frequency (Hz)"     ; brick:isPointOf bldg:cooling_tower_1 .
bldg:ct1_freq_write   a brick:Frequency_Command; rdfs:label "CT-1 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:cooling_tower_1 .
bldg:ct1_power        a brick:Electric_Power_Sensor ; rdfs:label "CT-1 Power (kW)"        ; brick:isPointOf bldg:cooling_tower_1 .

bldg:cooling_tower_2 a brick:Cooling_Tower ;
    rdfs:label "Cooling Tower CT-2 (2 cells)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ct2_status_read , bldg:ct2_status_write , bldg:ct2_alarm ,
        bldg:ct2_freq_read , bldg:ct2_freq_write , bldg:ct2_power .

bldg:ct2_status_read  a brick:On_Off_Status    ; rdfs:label "CT-2 Running Status"         ; brick:isPointOf bldg:cooling_tower_2 .
bldg:ct2_status_write a brick:On_Off_Command   ; rdfs:label "CT-2 Start/Stop Command"     ; brick:isPointOf bldg:cooling_tower_2 .
bldg:ct2_alarm        a brick:Alarm            ; rdfs:label "CT-2 Alarm Status"           ; brick:isPointOf bldg:cooling_tower_2 .
bldg:ct2_freq_read    a brick:Frequency_Sensor ; rdfs:label "CT-2 VSD Frequency (Hz)"     ; brick:isPointOf bldg:cooling_tower_2 .
bldg:ct2_freq_write   a brick:Frequency_Command; rdfs:label "CT-2 VSD Freq Command (Hz)"  ; brick:isPointOf bldg:cooling_tower_2 .
bldg:ct2_power        a brick:Electric_Power_Sensor ; rdfs:label "CT-2 Power (kW)"        ; brick:isPointOf bldg:cooling_tower_2 .

bldg:cooling_tower_3 a brick:Cooling_Tower ;
    rdfs:label "Cooling Tower CT-3 (2 cells)" ;
    brick:isPartOf bldg:building ;
    brick:hasPoint
        bldg:ct3_status_read , bldg:ct3_status_write , bldg:ct3_alarm ,
        bldg:ct3_freq_read , bldg:ct3_freq_write , bldg:ct3_power .

